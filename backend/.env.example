[TEMPLATE]
# ── Server ──
PORT=4000
NODE_ENV=development

# ── Database (MySQL) ──
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=soma_library

# ── Auth ──
# Production refuses to boot while this is still the dev placeholder.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Storage (private PDF storage, never public) ──
PDF_STORAGE_PATH=./storage/pdfs
COVER_STORAGE_PATH=./storage/covers
MAX_PDF_UPLOAD_MB=50

# Serve reader PDFs without a token while the API has no auth yet (#9/#10).
# Development only — ignored in production, where a signed, file-scoped reader
# token is always required. Set to false to test the locked path locally.
PDF_DEV_PUBLIC=true

# ── CORS ──
CORS_ORIGIN=http://localhost:5173
