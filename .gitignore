# ── Dependencies ──
node_modules/

# ── Build output ──
frontend/dist/
backend/dist/
*.tsbuildinfo

# ── Environment & secrets ──
.env
.env.local
.env.*.local

# ── Private PDF/covers storage (never commit) ──
# Runtime uploads are written here and must stay out of git. The demo PDFs are
# tracked in backend/fixtures/pdfs instead and copied in on the first dev boot
# (see backend/src/lib/storage.ts).
storage/
backend/storage/

# ── Logs ──
*.log
npm-debug.log*

# ── OS / editor ──
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Agent skills (local installs via skills CLI, never commit) ──
.agents/skills/
.claude/skills/
agent/skills/
skills-lock.json
